<?xml version="1.0" encoding="utf-8"?>
<!--
    Part D: landscape main screen.

    Identical to res/layout/activity_main.xml except for the bottom half: the
    same four weighted cells are now placed inside a single horizontal
    LinearLayout so that they line up in one row instead of a two-by-two grid.
    Because the cells are still driven by weights, nothing else has to change.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- ================= Banner (top half) ================= -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/imageViewBanner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/main_banner_description"
            android:scaleType="centerCrop"
            android:src="@drawable/img_main_banner" />

        <TextView
            android:id="@+id/textViewBannerTitle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="@dimen/spacing_small"
            android:text="@string/banner_title"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="40sp" />
    </FrameLayout>

    <!-- ================= Topics (bottom half, single row) ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/green"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/imageButtonFacilities"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/btn_topic_selector"
                android:contentDescription="@string/label_facilities"
                android:scaleType="fitCenter"
                android:src="@drawable/img_btn_facilities" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/label_facilities"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_topic_label" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/imageButtonEvents"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/btn_topic_selector"
                android:contentDescription="@string/label_events"
                android:scaleType="fitCenter"
                android:src="@drawable/img_btn_events" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/label_events"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_topic_label" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/imageButtonClubs"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/btn_topic_selector"
                android:contentDescription="@string/label_clubs"
                android:scaleType="fitCenter"
                android:src="@drawable/img_btn_clubs" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/label_clubs"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_topic_label" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/imageButtonSupport"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/btn_topic_selector"
                android:contentDescription="@string/label_support"
                android:scaleType="fitCenter"
                android:src="@drawable/img_btn_support" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/label_support"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_topic_label" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
